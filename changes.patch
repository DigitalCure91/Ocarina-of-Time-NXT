+    if(!ptr||self->ready!=2){Actor_Kill(actor);return;}
+    Unit& u=*ptr;
+    if(!Running(play)){self->body.base.acFlags&=~AC_HIT;return;}
+    if(self->body.base.acFlags&AC_HIT){
